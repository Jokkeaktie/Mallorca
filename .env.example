# Kopiér denne fil til ".env.local" og udfyld de rigtige værdier.
# ".env.local" må ALDRIG committes til Git (den er allerede i .gitignore).

# Findes i Supabase-projektet under Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://dit-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=din-anon-public-key

# Samme URL som ovenfor, men uden NEXT_PUBLIC_-præfiks (bruges kun server-side).
SUPABASE_URL=https://dit-projekt.supabase.co

# Findes i Supabase under Project Settings -> API -> "service_role" (hemmelig!).
# Må ALDRIG eksponeres til browseren eller committes til Git.
SUPABASE_SERVICE_ROLE_KEY=din-service-role-key

# En tilfældig, lang hemmelig streng der bruges til at signere familiens
# adgangs-cookie. Generér fx med: openssl rand -base64 32
FAMILY_SESSION_SECRET=erstat-med-en-lang-tilfaeldig-streng

# --- Valgfrit: e-mail-notifikation når nogen sender et ønske om booking ---
# Uden disse tre sendes der bare ingen mail (ønsket oprettes stadig fint).
# Se README, afsnit "E-mail-notifikationer", for opsætning.

# Den Gmail-adresse, mailen sendes FRA (kræver en "app-adgangskode" fra
# Google - IKKE din almindelige Gmail-adgangskode, se README).
GMAIL_USER=din-konto@gmail.com

# App-adgangskoden fra Google (16 tegn, evt. med mellemrum - begge dele virker).
GMAIL_APP_PASSWORD=

# Modtagere, kommasepareret (typisk jeres to e-mails - må gerne være
# forskellige udbydere, fx én Gmail-adresse og én på jeres eget domæne).
ADMIN_NOTIFICATION_EMAILS=sven@eksempel.dk,inger@eksempel.dk

# Valgfrit: jeres appens rigtige URL, så mailen kan linke direkte til
# administratorområdet (fx https://mallorca-xxxxx.vercel.app).
NEXT_PUBLIC_APP_URL=
